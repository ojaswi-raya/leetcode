import pandas as pd

def big_countries(world: pd.DataFrame) -> pd.DataFrame:
    # Filter rows using OR (|) and return only required columns
    return world[
        (world["area"] >= 3000000) | (world["population"] >= 25000000)
    ][["name", "population", "area"]]


# --- Create the test table (World DataFrame) ---
data = {
    'name': ['Afghanistan', 'Albania', 'Algeria', 'Andorra', 'Angola'],
    'continent': ['Asia', 'Europe', 'Africa', 'Europe', 'Africa'],
    'area': [652230, 28748, 2381741, 468, 1246700],
    'population': [25500100, 2831741, 37100000, 78115, 20609294],
    'gdp': [20343000000, 12960000000, 188681000000, 371200000, 100990000000]
}

world_df = pd.DataFrame(data)

# --- Call the function and print the output table ---
print(big_countries(world_df))